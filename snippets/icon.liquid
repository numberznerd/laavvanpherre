{%- comment -%}
  Inline SVG icons. Usage: {% render 'icon', icon: 'cart' %}
{%- endcomment -%}
{%- liquid
  assign name = icon | default: 'cart'
-%}
{%- case name -%}
  {%- when 'cart' -%}
    <svg class="icon icon-cart" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M3 4h2l2.4 12.2a1 1 0 0 0 1 .8h9.2a1 1 0 0 0 1-.8L20.5 8H6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9.5" cy="20" r="1.3" fill="currentColor"/><circle cx="17.5" cy="20" r="1.3" fill="currentColor"/></svg>
  {%- when 'search' -%}
    <svg class="icon icon-search" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.4"/><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  {%- when 'menu' -%}
    <svg class="icon icon-menu" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  {%- when 'close' -%}
    <svg class="icon icon-close" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  {%- when 'chevron' -%}
    <svg class="icon icon-chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
  {%- when 'minus' -%}
    <svg class="icon icon-minus" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M5 12h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  {%- when 'plus' -%}
    <svg class="icon icon-plus" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
  {%- when 'instagram' -%}
    <svg class="icon icon-instagram" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" stroke="currentColor" stroke-width="1.4"/><circle cx="12" cy="12" r="3.6" stroke="currentColor" stroke-width="1.4"/><circle cx="17" cy="7" r="1" fill="currentColor"/></svg>
  {%- when 'facebook' -%}
    <svg class="icon icon-facebook" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M14 8h2V5h-2c-1.7 0-3 1.3-3 3v2H9v3h2v6h3v-6h2.2l.8-3H14V8.5c0-.3.2-.5.5-.5Z" fill="currentColor"/></svg>
  {%- when 'tiktok' -%}
    <svg class="icon icon-tiktok" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M14 4c.3 2.2 1.8 3.7 4 4v2.2c-1.5 0-2.9-.5-4-1.3V15a5 5 0 1 1-5-5c.3 0 .6 0 1 .1v2.3a2.7 2.7 0 1 0 1.9 2.6V4H14Z" fill="currentColor"/></svg>
  {%- when 'youtube' -%}
    <svg class="icon icon-youtube" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><rect x="3" y="6" width="18" height="12" rx="3" stroke="currentColor" stroke-width="1.4"/><path d="M11 9.5v5l4-2.5-4-2.5Z" fill="currentColor"/></svg>
  {%- when 'lotus' -%}
    <svg class="icon icon-lotus" viewBox="0 0 48 30" fill="none" aria-hidden="true" focusable="false"><path d="M24 27c-9 0-16-5-18-13 4-1.4 7.6-.4 10 2-.4-5.6 2.4-10.4 8-14 5.6 3.6 8.4 8.4 8 14 2.4-2.4 6-3.4 10-2-2 8-9 13-18 13Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/><path d="M24 27c-2.6-3.6-4-7.6-4-12M24 27c2.6-3.6 4-7.6 4-12" stroke="currentColor" stroke-width="1.1"/></svg>
{%- endcase -%}
