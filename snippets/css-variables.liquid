{%- comment -%}
  Design tokens. Colours come from theme settings; fonts load via Google Fonts
  in layout/theme.liquid <head>.
{%- endcomment -%}
<style>
  :root {
    /* Colours — Concept 5 palette */
    --color-background: {{ settings.color_background }};
    --color-text: {{ settings.color_text }};
    --color-heading: {{ settings.color_heading }};
    --color-dark: {{ settings.color_dark }};
    --color-accent: {{ settings.color_accent }};
    --color-accent-dark: {{ settings.color_accent_dark }};
    --color-accent-contrast: {{ settings.color_accent_contrast }};
    --color-secondary: {{ settings.color_secondary }};
    --color-soft: {{ settings.color_soft }};
    --color-silver: {{ settings.color_gold }};
    --color-surface: {{ settings.color_surface }};
    --color-border: {{ settings.color_border }};

    /* Fixed brand palette */
    --brand-mauve: #E3B0C8;
    --brand-purple: #A23C7A;
    --brand-burgundy: #BB1E3F;
    --brand-silver: #C8C8D4;

    /* Typography */
    --font-brand: 'Coustard', serif;
    --font-heading-family: 'Coustard', serif;
    --font-heading-style: normal;
    --font-heading-weight: 900;
    --font-body-family: 'Coustard', serif;
    --font-body-style: normal;
    --font-body-weight: 400;
    --font-body-weight-bold: 900;
    --font-accent: 'Coustard', serif;
    --font-display-family: 'Coustard', serif;

    --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
    --page-width: {{ settings.page_width }}px;
    --section-spacing: {{ settings.section_spacing }}px;
    --card-radius: {{ settings.card_corner_radius }};
  }
</style>
