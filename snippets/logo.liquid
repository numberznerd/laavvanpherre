{%- comment -%}
  Laavvan Pherre logo lockup — inline SVG medallion + wordmark.
  Params:
    variant : 'full' (badge + wordmark) | 'compact' (badge only, mobile)
    class   : extra classes (e.g. 'logo--desktop')
{%- endcomment -%}
{%- assign variant = variant | default: 'full' -%}
<span class="logo logo--{{ variant }} {{ class }}">
  <span class="logo__badge">
    <svg viewBox="0 0 200 250" role="img" aria-label="{{ shop.name | escape }}" xmlns="http://www.w3.org/2000/svg">
      <!-- Oval badge with double gold border -->
      <ellipse cx="100" cy="115" rx="81" ry="104" fill="none" stroke="#C9A84C" stroke-width="1.2"/>
      <ellipse cx="100" cy="115" rx="74" ry="96" fill="#8B1A2F"/>
      <ellipse cx="100" cy="115" rx="74" ry="96" fill="none" stroke="#C9A84C" stroke-width="2"/>

      <!-- Corner filigree flourishes -->
      <g fill="none" stroke="#C9A84C" stroke-width="1.3" stroke-linecap="round">
        <path d="M47 52 q13 -11 26 -6"/><path d="M47 52 q-2 13 7 24"/>
        <path d="M153 52 q-13 -11 -26 -6"/><path d="M153 52 q2 13 -7 24"/>
        <path d="M47 178 q13 11 26 6"/><path d="M153 178 q-13 11 -26 6"/>
      </g>

      <!-- Ornamental diamonds at N / S / E / W -->
      <g fill="#C9A84C">
        <path d="M100 5 l6 6 -6 6 -6 -6 z"/>
        <path d="M100 219 l6 6 -6 6 -6 -6 z"/>
        <path d="M181 109 l6 6 -6 6 -6 -6 z"/>
        <path d="M19 109 l6 6 -6 6 -6 -6 z"/>
      </g>

      <!-- Interlocking LP monogram (L behind P) -->
      <g fill="#C9A84C" font-family="'Cinzel', serif" font-weight="700" text-anchor="middle">
        <text x="88" y="126" font-size="88">L</text>
        <text x="112" y="126" font-size="88">P</text>
      </g>

      <!-- Lotus — 7 petals -->
      <g transform="translate(100 168)">
        <ellipse cx="0" cy="1" rx="13" ry="5" fill="#B85C82"/>
        <g fill="#D4789A">
          <path transform="rotate(-78)" d="M0 0 C-6 -10 -4 -22 0 -26 C4 -22 6 -10 0 0 Z"/>
          <path transform="rotate(78)" d="M0 0 C-6 -10 -4 -22 0 -26 C4 -22 6 -10 0 0 Z"/>
          <path transform="rotate(-52)" d="M0 0 C-7 -12 -5 -25 0 -29 C5 -25 7 -12 0 0 Z"/>
          <path transform="rotate(52)" d="M0 0 C-7 -12 -5 -25 0 -29 C5 -25 7 -12 0 0 Z"/>
          <path transform="rotate(-26)" d="M0 0 C-8 -14 -5 -30 0 -34 C5 -30 8 -14 0 0 Z"/>
          <path transform="rotate(26)" d="M0 0 C-8 -14 -5 -30 0 -34 C5 -30 8 -14 0 0 Z"/>
          <path d="M0 0 C-8 -14 -5 -31 0 -35 C5 -31 8 -14 0 0 Z"/>
        </g>
        <g fill="#EBA9C5">
          <path transform="rotate(-26)" d="M0 -9 C-4 -17 -3 -27 0 -31 C3 -27 4 -17 0 -9 Z"/>
          <path transform="rotate(26)" d="M0 -9 C-4 -17 -3 -27 0 -31 C3 -27 4 -17 0 -9 Z"/>
          <path d="M0 -9 C-4 -18 -3 -28 0 -32 C3 -28 4 -18 0 -9 Z"/>
        </g>
      </g>

      <!-- Jewel teardrop inside the oval, below the lotus -->
      <ellipse cx="100" cy="186" rx="4.5" ry="3" fill="#C9A84C"/>
      <path d="M100 188 C93 196 93 205 100 210 C107 205 107 196 100 188 Z" fill="#A23C7A"/>
      <path d="M100 192 C97 196 97 201 100 205 C103 201 103 196 100 192 Z" fill="#C77DA6"/>
    </svg>
  </span>

  {%- if variant == 'full' -%}
    <span class="logo__wordmark">
      <span class="logo__name">Laavvan Pherre</span>
      <span class="logo__rule"><span class="logo__diamond">❖</span></span>
      <span class="logo__tagline">Clothing · Jewelry · Bridal Wear · Casual Wear · Everyday Fashion</span>
    </span>
  {%- endif -%}
</span>
