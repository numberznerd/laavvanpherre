{%- comment -%}
  Laavvan Pherre — Concept 5 Luxury Monogram logo (pixel-precise SVG).
  Params:
    variant : 'full' (oval + wordmark + rule + tagline, viewBox 300x420)
            | 'compact' (oval badge only, viewBox 300x295)
    class   : extra classes (e.g. 'logo--desktop')
  Fonts (Pinyon Script, Cinzel) are loaded via Google Fonts in theme.liquid.
{%- endcomment -%}
{%- assign variant = variant | default: 'full' -%}
{%- if variant == 'compact' -%}
  {%- assign viewbox = '0 0 300 295' -%}
{%- else -%}
  {%- assign viewbox = '0 0 300 420' -%}
{%- endif -%}
<span class="logo logo--{{ variant }} {{ class }}">
  <svg class="logo__svg" viewBox="{{ viewbox }}" role="img" aria-label="Laavvan Pherre" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <radialGradient id="lpGlow" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" stop-color="#C9A84C" stop-opacity="0.16"/>
        <stop offset="1" stop-color="#C9A84C" stop-opacity="0"/>
      </radialGradient>
      <path id="lpFlourish" d="M75,60 C70,55 65,52 60,50 C63,54 67,58 68,63 C70,60 73,58 75,60 Z M75,60 C78,55 80,50 82,47 C79,51 77,56 75,60 Z" fill="#C9A84C"/>
      <path id="lpPetal" d="M150,225 C147,215 144,205 145,195 C146,185 150,182 150,182 C150,182 154,185 155,195 C156,205 153,215 150,225 Z" fill="#D4789A"/>
      <circle id="lpTip" cx="150" cy="184" r="2" fill="#E8A8C0"/>
    </defs>

    <!-- LAYER 1 — oval badge: burgundy fill with double gold border + cream gap -->
    <ellipse cx="150" cy="155" rx="93" ry="118" fill="none" stroke="#C9A84C" stroke-width="2"/>
    <ellipse cx="150" cy="155" rx="90" ry="115" fill="#BB1E3F"/>
    <ellipse cx="150" cy="155" rx="90.5" ry="115.5" fill="none" stroke="#fdf8f3" stroke-width="1.5"/>
    <ellipse cx="150" cy="155" rx="88" ry="113" fill="none" stroke="#C9A84C" stroke-width="1.5"/>

    <!-- LAYER 6 (under ornaments) — corner rays + leaf studs around the oval -->
    <g stroke="#C9A84C" stroke-width="0.8" opacity="0.85">
      <line x1="85" y1="75" x2="75" y2="60"/>
      <line x1="215" y1="75" x2="225" y2="60"/>
      <line x1="85" y1="235" x2="75" y2="250"/>
      <line x1="215" y1="235" x2="225" y2="250"/>
    </g>
    <g fill="#C9A84C">
      <circle cx="184" cy="49" r="2"/><circle cx="233" cy="111" r="2"/>
      <circle cx="233" cy="199" r="2"/><circle cx="184" cy="261" r="2"/>
      <circle cx="116" cy="261" r="2"/><circle cx="67" cy="199" r="2"/>
      <circle cx="67" cy="111" r="2"/><circle cx="116" cy="49" r="2"/>
    </g>

    <!-- LAYER 2 — corner flourishes (mirrored), diamond studs, sparkle dots -->
    <use href="#lpFlourish"/>
    <use href="#lpFlourish" transform="scale(-1,1) translate(-300,0)"/>
    <use href="#lpFlourish" transform="scale(1,-1) translate(0,-310)"/>
    <use href="#lpFlourish" transform="scale(-1,-1) translate(-300,-310)"/>
    <g fill="#C9A84C">
      <path d="M0,-5 L3,0 L0,5 L-3,0 Z" transform="translate(150,37)"/>
      <path d="M0,-5 L3,0 L0,5 L-3,0 Z" transform="translate(150,273)"/>
      <path d="M0,-5 L3,0 L0,5 L-3,0 Z" transform="translate(243,155)"/>
      <path d="M0,-5 L3,0 L0,5 L-3,0 Z" transform="translate(57,155)"/>
      <circle cx="207" cy="67" r="2.5"/><circle cx="93" cy="67" r="2.5"/>
      <circle cx="207" cy="243" r="2.5"/><circle cx="93" cy="243" r="2.5"/>
    </g>

    <!-- LAYER 3 — LP monogram with inner glow (L behind, P overlapping) -->
    <ellipse cx="150" cy="150" rx="74" ry="84" fill="url(#lpGlow)"/>
    <text class="logo__mono" x="105" y="175" font-family="'Cinzel', serif" font-size="95" font-weight="600" fill="#C9A84C" opacity="0.95">L</text>
    <text class="logo__mono" x="140" y="175" font-family="'Cinzel', serif" font-size="95" font-weight="600" fill="#C9A84C">P</text>

    <!-- LAYER 4 — lotus, 7 petals + lighter tips + gold stamen -->
    <use href="#lpPetal" transform="rotate(-75 150 225)"/>
    <use href="#lpPetal" transform="rotate(-50 150 225)"/>
    <use href="#lpPetal" transform="rotate(-25 150 225)"/>
    <use href="#lpPetal"/>
    <use href="#lpPetal" transform="rotate(25 150 225)"/>
    <use href="#lpPetal" transform="rotate(50 150 225)"/>
    <use href="#lpPetal" transform="rotate(75 150 225)"/>
    <use href="#lpTip" transform="rotate(-75 150 225)"/>
    <use href="#lpTip" transform="rotate(-50 150 225)"/>
    <use href="#lpTip" transform="rotate(-25 150 225)"/>
    <use href="#lpTip"/>
    <use href="#lpTip" transform="rotate(25 150 225)"/>
    <use href="#lpTip" transform="rotate(50 150 225)"/>
    <use href="#lpTip" transform="rotate(75 150 225)"/>
    <g fill="#C9A84C">
      <circle cx="150" cy="224" r="1.5"/><circle cx="146" cy="226" r="1.5"/>
      <circle cx="154" cy="226" r="1.5"/><circle cx="148" cy="222" r="1.5"/>
      <circle cx="152" cy="222" r="1.5"/>
    </g>

    <!-- LAYER 5 — jewel teardrop with gold cap + highlight -->
    <path d="M150,227 C145,232 140,240 140,248 C140,254 144,258 150,258 C156,258 160,254 160,248 C160,240 155,232 150,227 Z" fill="#A23C7A"/>
    <path d="M145,229 C147,226 150,225 153,229 C151,228 150,227 149,228 Z" fill="#C9A84C"/>
    <ellipse cx="147" cy="237" rx="3" ry="2" fill="#ffffff" fill-opacity="0.35"/>

    {%- if variant == 'full' -%}
      <!-- Wordmark + ornamental rule + tagline -->
      <text class="logo__name-svg" x="150" y="305" font-family="'Pinyon Script', cursive" font-size="38" fill="#8B1A2F" text-anchor="middle" letter-spacing="1">Laavvan Pherre</text>
      <line x1="30" y1="318" x2="132" y2="318" stroke="#C9A84C" stroke-width="0.8"/>
      <text x="150" y="322" font-size="10" fill="#C9A84C" text-anchor="middle">❖</text>
      <line x1="168" y1="318" x2="270" y2="318" stroke="#C9A84C" stroke-width="0.8"/>
      <text class="logo__tagline-svg" x="150" y="338" font-family="'Cinzel', serif" font-size="5.5" fill="#A23C7A" text-anchor="middle" letter-spacing="0.8">CLOTHING · JEWELRY · BRIDAL WEAR · CASUAL WEAR · EVERYDAY FASHION</text>
    {%- endif -%}
  </svg>
</span>
