{%- if section.settings.text != blank -%}
  <div class="announcement-bar">
    {%- if section.settings.link != blank -%}
      <a class="announcement-bar__text page-width" href="{{ section.settings.link }}">{{ section.settings.text }}</a>
    {%- else -%}
      <p class="announcement-bar__text page-width">{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Complimentary shipping across Canada on orders over $150"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ]
}
{% endschema %}
