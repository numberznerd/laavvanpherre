<header class="site-header" data-header>
  <div class="page-width site-header__bar">
    <div class="site-header__utility site-header__utility--left">
      <button
        class="header-actions__button header-menu-toggle"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="MobileNav"
        aria-label="{{ 'accessibility.menu' | t }}">
        {% render 'icon', icon: 'menu' %}
      </button>
    </div>

    <div class="site-header__logo">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {%- if settings.logo != blank -%}
          <img
            class="header-logo-img header-logo-img--desktop"
            src="{{ settings.logo | image_url: width: 600 }}"
            srcset="{{ settings.logo | image_url: width: 300 }} 300w, {{ settings.logo | image_url: width: 600 }} 600w"
            sizes="(max-width: 767px) 120px, {{ settings.logo_width }}px"
            alt="{{ settings.logo.alt | default: shop.name | escape }}"
            width="{{ settings.logo.width }}"
            height="{{ settings.logo.height }}"
            loading="eager"
            style="max-width: {{ settings.logo_width }}px;">
        {%- else -%}
          {% render 'logo', variant: 'full', class: 'logo--desktop' %}
          {% render 'logo', variant: 'compact', class: 'logo--mobile' %}
        {%- endif -%}
      </a>
    </div>

    <div class="site-header__utility site-header__utility--right">
      <a class="header-actions__button" href="{{ routes.search_url }}" aria-label="{{ 'accessibility.search' | t }}">
        {% render 'icon', icon: 'search' %}
      </a>
      <a class="header-actions__button" href="{{ routes.cart_url }}" aria-label="{{ 'accessibility.cart' | t }}">
        {% render 'icon', icon: 'cart' %}
        <span class="cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  {%- if section.settings.menu != blank and section.settings.menu.links.size > 0 -%}
    <nav class="site-header__nav" aria-label="Primary">
      {%- for link in section.settings.menu.links -%}
        <a
          class="site-nav__link"
          href="{{ link.url }}"
          {% if link.current %}aria-current="page"{% endif %}>
          {{ link.title }}
        </a>
      {%- endfor -%}
    </nav>
  {%- endif -%}
</header>

<div class="overlay" data-overlay aria-hidden="true"></div>
<aside class="mobile-nav" id="MobileNav" data-mobile-nav aria-hidden="true" aria-label="Menu">
  <button class="header-actions__button" data-menu-close aria-label="{{ 'accessibility.close' | t }}">
    {% render 'icon', icon: 'close' %}
  </button>
  {%- if section.settings.menu != blank -%}
    <nav>
      {%- for link in section.settings.menu.links -%}
        <a class="mobile-nav__link" href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </nav>
  {%- endif -%}
</aside>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Wordmark text",
      "info": "Shown when no logo image is uploaded",
      "default": "Laavvan Pherre"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
