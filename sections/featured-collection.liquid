{%- assign fc = section.settings.collection -%}
<section class="section featured-collection{% if section.settings.background == 'tint' %} section--tint{% endif %}">
  <div class="page-width">
    <div class="section__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="ornament"><span class="ornament__diamond">❖</span></div>
    </div>

    {%- if fc != blank and fc.products.size > 0 -%}
      <div class="product-grid{% if section.settings.columns == '4' %} product-grid--4{% endif %}">
        {%- for product in fc.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product, show_quick_add: section.settings.show_quick_add, show_tag: section.settings.show_tag, show_vendor: section.settings.show_vendor %}
        {%- endfor -%}
      </div>
      {%- if section.settings.show_view_all -%}
        <div class="featured-collection__footer">
          <a class="button button--secondary" href="{{ fc.url }}">
            {{ section.settings.view_all_label | default: 'View all' }}
          </a>
        </div>
      {%- endif -%}
    {%- else -%}
      <p class="rich-text__body" style="text-align: center;">Choose a collection to feature its products here.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best Sellers" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (desktop)",
      "options": [
        { "value": "3", "label": "3 across" },
        { "value": "4", "label": "4 across" }
      ],
      "default": "3"
    },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Products to show", "default": 6 },
    { "type": "checkbox", "id": "show_quick_add", "label": "Show 'Add to cart' on hover", "default": true },
    { "type": "checkbox", "id": "show_tag", "label": "Show category tag", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor (if no tag)", "default": false },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'view all' button", "default": true },
    { "type": "text", "id": "view_all_label", "label": "'View all' label", "default": "View all" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "tint", "label": "Soft tint" }
      ],
      "default": "none"
    }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
