{%- assign fc = section.settings.collection -%}
<section class="section featured-collection">
  <div class="page-width">
    <div class="section__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="ornament"><span class="ornament__diamond">◆</span></div>
    </div>

    {%- if fc != blank and fc.products.size > 0 -%}
      <div class="product-grid">
        {%- for product in fc.products limit: section.settings.products_to_show -%}
          {% render 'product-card', product: product, show_vendor: section.settings.show_vendor %}
        {%- endfor -%}
      </div>
      {%- if section.settings.show_view_all -%}
        <div class="featured-collection__footer">
          <a class="button button--secondary" href="{{ fc.url }}">
            {{ section.settings.view_all_label | default: 'View all' }}
          </a>
        </div>
      {%- endif -%}
    {%- else -%}
      <p class="rich-text__body" style="text-align: center;">Choose a collection to feature its products here.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'view all' button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "'View all' label",
      "default": "View all"
    }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
