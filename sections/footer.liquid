<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}" class="site-footer__logo-link">
          {% render 'logo', variant: 'full' %}
        </a>

        {%- liquid
          assign has_social = false
          if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_tiktok != blank or settings.social_youtube != blank
            assign has_social = true
          endif
        -%}
        {%- if has_social -%}
          <div class="site-footer__social">
            {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" aria-label="{{ 'general.social.instagram' | t }}" target="_blank" rel="noopener">{% render 'icon', icon: 'instagram' %}</a>{%- endif -%}
            {%- if settings.social_facebook != blank -%}<a href="{{ settings.social_facebook }}" aria-label="{{ 'general.social.facebook' | t }}" target="_blank" rel="noopener">{% render 'icon', icon: 'facebook' %}</a>{%- endif -%}
            {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" aria-label="{{ 'general.social.tiktok' | t }}" target="_blank" rel="noopener">{% render 'icon', icon: 'tiktok' %}</a>{%- endif -%}
            {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" aria-label="{{ 'general.social.youtube' | t }}" target="_blank" rel="noopener">{% render 'icon', icon: 'youtube' %}</a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.shop_menu != blank -%}
        <nav class="site-footer__col" aria-label="{{ section.settings.shop_menu_title }}">
          <p class="site-footer__heading">{{ section.settings.shop_menu_title }}</p>
          <ul class="site-footer__menu">
            {%- for link in section.settings.shop_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      {%- if section.settings.about_menu != blank -%}
        <nav class="site-footer__col" aria-label="{{ section.settings.about_menu_title }}">
          <p class="site-footer__heading">{{ section.settings.about_menu_title }}</p>
          <ul class="site-footer__menu">
            {%- for link in section.settings.about_menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}

      {%- if section.settings.show_newsletter -%}
        <div class="site-footer__col site-footer__newsletter">
          <p class="site-footer__heading">{{ section.settings.newsletter_title }}</p>
          {%- if section.settings.newsletter_text != blank -%}
            <p class="site-footer__newsletter-text">{{ section.settings.newsletter_text }}</p>
          {%- endif -%}
          {%- form 'customer', class: 'newsletter__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="FooterEmail">{{ 'general.newsletter.label' | t }}</label>
            <input id="FooterEmail" type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" required>
            <button type="submit" class="button button--primary">{{ 'general.newsletter.button' | t }}</button>
            {%- if form.posted_successfully? -%}
              <p class="form-success">{{ 'general.newsletter.success' | t }}</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}{% if section.settings.copyright != blank %} · {{ section.settings.copyright }}{% endif %}</p>
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <div class="site-footer__payments">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "textarea", "id": "tagline", "label": "Brand tagline", "default": "Inspired by heritage. Designed for today." },
    { "type": "header", "content": "Shop column" },
    { "type": "text", "id": "shop_menu_title", "label": "Heading", "default": "Shop" },
    { "type": "link_list", "id": "shop_menu", "label": "Menu", "default": "footer" },
    { "type": "header", "content": "About column" },
    { "type": "text", "id": "about_menu_title", "label": "Heading", "default": "About" },
    { "type": "link_list", "id": "about_menu", "label": "Menu", "default": "about" },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter signup", "default": true },
    { "type": "text", "id": "newsletter_title", "label": "Heading", "default": "Join the list" },
    { "type": "text", "id": "newsletter_text", "label": "Text", "default": "First access to new collections and bridal previews." },
    { "type": "header", "content": "Bottom bar" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "text", "id": "copyright", "label": "Copyright note", "default": "All rights reserved." }
  ]
}
{% endschema %}
