<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <p class="site-footer__brand-name">{{ shop.name }}</p>
        {%- if section.settings.tagline != blank -%}
          <p>{{ section.settings.tagline }}</p>
        {%- endif -%}

        {%- liquid
          assign has_social = false
          if settings.social_instagram != blank or settings.social_facebook != blank or settings.social_tiktok != blank or settings.social_youtube != blank
            assign has_social = true
          endif
        -%}
        {%- if has_social -%}
          <div class="site-footer__social">
            {%- if settings.social_instagram != blank -%}
              <a href="{{ settings.social_instagram }}" aria-label="{{ 'general.social.instagram' | t }}" target="_blank" rel="noopener">{% render 'icon', icon: 'instagram' %}</a>
            {%- endif -%}
            {%- if settings.social_facebook != blank -%}
              <a href="{{ settings.social_facebook }}" aria-label="{{ 'general.social.facebook' | t }}" target="_blank" rel="noopener">{% render 'icon', icon: 'facebook' %}</a>
            {%- endif -%}
            {%- if settings.social_tiktok != blank -%}
              <a href="{{ settings.social_tiktok }}" aria-label="{{ 'general.social.tiktok' | t }}" target="_blank" rel="noopener">{% render 'icon', icon: 'tiktok' %}</a>
            {%- endif -%}
            {%- if settings.social_youtube != blank -%}
              <a href="{{ settings.social_youtube }}" aria-label="{{ 'general.social.youtube' | t }}" target="_blank" rel="noopener">{% render 'icon', icon: 'youtube' %}</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.menu != blank -%}
        <div class="site-footer__col">
          <p class="site-footer__heading">{{ section.settings.menu_title }}</p>
          <ul class="site-footer__menu">
            {%- for link in section.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      {%- if section.settings.show_newsletter -%}
        <div class="site-footer__col">
          <p class="site-footer__heading">{{ section.settings.newsletter_title }}</p>
          {%- if section.settings.newsletter_text != blank -%}
            <p>{{ section.settings.newsletter_text }}</p>
          {%- endif -%}
          {%- form 'customer', class: 'newsletter__form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <label class="visually-hidden" for="FooterEmail">{{ 'general.newsletter.label' | t }}</label>
            <input id="FooterEmail" type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" required>
            <button type="submit" class="button button--secondary">{{ 'general.newsletter.button' | t }}</button>
            {%- if form.posted_successfully? -%}
              <p class="form-success">{{ 'general.newsletter.success' | t }}</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}{% if section.settings.copyright != blank %} · {{ section.settings.copyright }}{% endif %}</p>
      <p>{{ powered_by_link }}</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Brand tagline",
      "default": "Inspired by heritage. Designed for today."
    },
    {
      "type": "header",
      "content": "Menu column"
    },
    {
      "type": "text",
      "id": "menu_title",
      "label": "Menu heading",
      "default": "Explore"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "footer"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter heading",
      "default": "Join the list"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "First access to new collections and bridal previews."
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright note",
      "default": "All rights reserved."
    }
  ]
}
{% endschema %}
