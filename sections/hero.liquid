{%- liquid
  assign hero_product = section.settings.featured_product
  if hero_product == blank
    assign hero_product = collections['necklace-sets'].products.first
  endif
-%}
<section class="hero-editorial" style="--hero-min: {{ section.settings.min_height }}vh;">
  <div class="hero-editorial__bg">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 2200 }}"
        srcset="{{ section.settings.image | image_url: width: 1100 }} 1100w, {{ section.settings.image | image_url: width: 2200 }} 2200w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="eager"
        fetchpriority="high">
    {%- endif -%}
  </div>
  <div class="hero-editorial__overlay"></div>

  <div class="page-width hero-editorial__inner">
    <div class="hero-editorial__content">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow eyebrow--light">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 class="hero-editorial__title">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="hero-editorial__text">{{ section.settings.text }}</p>
      {%- endif -%}
      <div class="hero-editorial__ctas">
        {%- if section.settings.button_label != blank -%}
          <a class="button button--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a class="button button--ghost-light" href="{{ section.settings.button2_link | default: routes.root_url }}">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      </div>
    </div>

    {%- if hero_product != blank -%}
      <a class="hero-card" href="{{ hero_product.url }}">
        <div class="hero-card__media">
          {%- if hero_product.featured_media -%}
            <img
              src="{{ hero_product.featured_media | image_url: width: 720 }}"
              alt="{{ hero_product.featured_media.alt | escape | default: hero_product.title }}"
              width="{{ hero_product.featured_media.width }}"
              height="{{ hero_product.featured_media.height }}"
              loading="eager">
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'hero-card__placeholder' }}
          {%- endif -%}
        </div>
        <div class="hero-card__info">
          <p class="hero-card__name">{{ hero_product.title }}</p>
          <p class="hero-card__price">{{ hero_product.price | money }}</p>
        </div>
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Optional. Without one, a deep burgundy gradient is used."
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New Collection · 2026" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Crafted in Heritage. Worn with Pride." },
    { "type": "textarea", "id": "text", "label": "Subtext", "default": "Bridal and festive jewellery, crafted from heritage and made for the woman of today." },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Explore Collection" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button2_label", "label": "Secondary button", "default": "Our Story" },
    { "type": "url", "id": "button2_link", "label": "Secondary button link" },
    { "type": "product", "id": "featured_product", "label": "Floating product card", "info": "Defaults to the first product in Necklace Sets." },
    { "type": "range", "id": "min_height", "min": 60, "max": 100, "step": 2, "unit": "vh", "label": "Height", "default": 90 }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
