{%- liquid
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
-%}
<section
  class="hero{% if has_image %} hero--has-image{% endif %}"
  style="min-height: {{ section.settings.min_height }}vh;">
  {%- if has_image -%}
    <div class="hero__media">
      <img
        src="{{ section.settings.image | image_url: width: 2200 }}"
        srcset="{{ section.settings.image | image_url: width: 1100 }} 1100w, {{ section.settings.image | image_url: width: 2200 }} 2200w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="eager"
        fetchpriority="high">
    </div>
    <div class="hero__overlay"></div>
  {%- endif -%}

  <div class="hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
    {%- endif -%}
    <div class="ornament"><span class="ornament__diamond">◆</span></div>
    {%- if section.settings.text != blank -%}
      <p class="hero__text">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="button button--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Optional. Without an image, a soft mauve-to-cream gradient is used."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Elegant · Heritage · Timeless"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Inspired by heritage. Designed for today."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Bridal and festive jewelry crafted to be worn and remembered."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "min_height",
      "min": 40,
      "max": 90,
      "step": 5,
      "unit": "vh",
      "label": "Height",
      "default": 65
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
