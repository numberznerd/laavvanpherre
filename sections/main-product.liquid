{%- assign current_variant = product.selected_or_first_available_variant -%}
<section class="product page-width" data-product>
  <div class="product__layout">
    <div class="product__media" data-gallery>
      {%- if product.featured_media -%}
        <img
          class="product__featured-image"
          data-gallery-featured
          src="{{ product.featured_media | image_url: width: 1200 }}"
          alt="{{ product.featured_media.alt | escape | default: product.title }}"
          width="{{ product.featured_media.width }}"
          height="{{ product.featured_media.height }}">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product__featured-image' }}
      {%- endif -%}

      {%- if product.media.size > 1 -%}
        <div class="product__thumbs">
          {%- for media in product.media -%}
            <img
              class="product__thumb"
              data-gallery-thumb
              data-full="{{ media | image_url: width: 1200 }}"
              src="{{ media | image_url: width: 200 }}"
              alt="{{ media.alt | escape }}"
              width="80"
              height="96"
              {% if forloop.first %}aria-current="true"{% endif %}>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product__info">
      {%- if product.vendor != blank -%}<p class="product__vendor">{{ product.vendor }}</p>{%- endif -%}
      <h1 class="product__title">{{ product.title }}</h1>
      <div class="product__price">{% render 'price', product: product, variant: current_variant %}</div>

      {%- form 'product', product, class: 'product__form', novalidate: 'novalidate' -%}
        {%- unless product.has_only_default_variant -%}
          <div class="product__variant-options">
            <label class="field-label" for="VariantId">{{ product.options_with_values.first.name | default: 'Options' }}</label>
            <select id="VariantId" name="id">
              {%- for variant in product.variants -%}
                <option
                  value="{{ variant.id }}"
                  {% if variant == current_variant %}selected{% endif %}
                  {% unless variant.available %}disabled{% endunless %}>
                  {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} · {{ 'products.product.sold_out' | t }}{% endunless %}
                </option>
              {%- endfor -%}
            </select>
          </div>
        {%- else -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {%- endunless -%}

        <div class="product__buy">
          <div class="quantity" data-quantity>
            <button type="button" class="quantity__button" data-quantity-button="decrease" aria-label="Decrease quantity">{% render 'icon', icon: 'minus' %}</button>
            <input class="quantity__input" type="number" name="quantity" value="1" min="1" inputmode="numeric" aria-label="{{ 'products.product.quantity' | t }}">
            <button type="button" class="quantity__button" data-quantity-button="increase" aria-label="Increase quantity">{% render 'icon', icon: 'plus' %}</button>
          </div>
          <button type="submit" name="add" class="button button--primary button--full" {% unless current_variant.available %}disabled{% endunless %}>
            {%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
          </button>
        </div>
      {%- endform -%}

      {%- if current_variant.sku != blank -%}
        <p class="product__sku" style="margin-top:1rem; font-size:.82rem; opacity:.7;">{{ 'products.product.sku' | t }}: {{ current_variant.sku }}</p>
      {%- endif -%}

      {%- if product.description != blank -%}
        <div class="product__description">
          <h2>{{ 'products.product.description' | t }}</h2>
          {{ product.description }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
