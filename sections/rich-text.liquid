<section class="section rich-text{% if section.settings.background == 'tint' %} section--tint{% endif %}">
  <div class="page-width">
    <div class="section__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2>{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="ornament"><span class="ornament__diamond">◆</span></div>
    </div>
    {%- if section.settings.text != blank -%}
      <div class="rich-text__body">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <div class="featured-collection__footer">
        <a class="button button--secondary" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Laavvan Pherre promise" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Every piece is chosen for the moments that matter most — engagements, weddings, festivals, and the everyday in between. Heritage craftsmanship, designed for the way you live now.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "tint", "label": "Soft tint" }
      ],
      "default": "tint"
    }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
