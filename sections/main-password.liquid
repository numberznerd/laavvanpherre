<section class="simple-page page-width">
  <p class="eyebrow">Elegant · Heritage · Timeless</p>
  <h1>{{ shop.name }}</h1>
  {%- if shop.password_message != blank -%}
    <div class="rich-text__body">{{ shop.password_message }}</div>
  {%- else -%}
    <p class="rich-text__body">Opening soon. Inspired by heritage. Designed for today.</p>
  {%- endif -%}
  <div class="ornament"><span class="ornament__diamond">◆</span></div>

  {%- form 'storefront_password' -%}
    <label class="field-label" for="StorefrontPassword">Enter using password</label>
    <div class="search-form">
      <input type="password" id="StorefrontPassword" name="password" placeholder="Password" autocomplete="current-password">
      <button type="submit" class="button button--primary">Enter</button>
    </div>
    {%- if form.errors -%}
      <p style="color: var(--color-accent); margin-top: 0.75rem;">{{ form.errors.messages.password }}</p>
    {%- endif -%}
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Password",
  "settings": []
}
{% endschema %}
