<section class="section collection-list-section{% if section.settings.background == 'tint' %} section--tint{% endif %}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section__header">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        <div class="ornament"><span class="ornament__diamond">◆</span></div>
      </div>
    {%- endif -%}

    <div class="collection-list">
      {%- for block in section.blocks -%}
        {%- assign col = block.settings.collection -%}
        <a class="collection-tile" href="{{ col.url | default: '#' }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.title | default: col.title | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
          {%- elsif col.featured_image != blank -%}
            <img src="{{ col.featured_image | image_url: width: 700 }}" alt="{{ col.title | escape }}" loading="lazy">
          {%- endif -%}
          <span class="collection-tile__label">{{ block.settings.title | default: col.title | default: 'Collection' }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "tint", "label": "Soft tint" }
      ],
      "default": "none"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image override" },
        { "type": "text", "id": "title", "label": "Title override" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Collection list",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
