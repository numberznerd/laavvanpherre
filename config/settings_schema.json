[
  {
    "name": "theme_info",
    "theme_name": "Laavvan Pherre",
    "theme_version": "0.1.0",
    "theme_author": "Laavvan Pherre",
    "theme_documentation_url": "https://shopify.dev/docs/themes",
    "theme_support_url": "https://laavvanpherre.myshopify.com"
  },
  {
    "name": "Brand",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo" },
      { "type": "range", "id": "logo_width", "min": 80, "max": 320, "step": 10, "unit": "px", "label": "Logo width", "default": 160 },
      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "Will be scaled to 32 x 32px" }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "header", "content": "Core" },
      { "type": "color", "id": "color_background", "label": "Background (cream)", "default": "#FDF8F3" },
      { "type": "color", "id": "color_text", "label": "Body text", "default": "#3D1A1A" },
      { "type": "color", "id": "color_heading", "label": "Headings", "default": "#3D1A1A" },
      { "type": "color", "id": "color_dark", "label": "Footer / dark sections", "default": "#1A0A0F" },
      { "type": "color", "id": "color_surface", "label": "Surface (cards)", "default": "#FFFFFF" },
      { "type": "color", "id": "color_border", "label": "Border", "default": "#E8D8C6" },
      { "type": "header", "content": "Brand palette" },
      { "type": "color", "id": "color_accent", "label": "Primary (burgundy)", "info": "Buttons, links, prices, CTAs", "default": "#BB1E3F" },
      { "type": "color", "id": "color_accent_dark", "label": "Primary dark (hover, wordmark)", "default": "#8B1A2F" },
      { "type": "color", "id": "color_accent_contrast", "label": "Primary text", "default": "#FFFFFF" },
      { "type": "color", "id": "color_secondary", "label": "Deep mauve (labels)", "default": "#A23C7A" },
      { "type": "color", "id": "color_soft", "label": "Soft tint (mauve sections)", "default": "#FAF0F5" },
      { "type": "color", "id": "color_gold", "label": "Gold (dividers, fine lines)", "default": "#C9A84C" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      { "type": "paragraph", "content": "Fonts are defined in the theme code: Pinyon Script (wordmark), Bodoni Moda (headings), Montserrat (body), Cinzel (accents)." },
      { "type": "range", "id": "heading_scale", "min": 90, "max": 130, "step": 5, "unit": "%", "label": "Heading size scale", "default": 100 }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      { "type": "range", "id": "page_width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "label": "Page width", "default": 1280 },
      { "type": "range", "id": "section_spacing", "min": 24, "max": 120, "step": 4, "unit": "px", "label": "Spacing between sections", "default": 72 },
      { "type": "select", "id": "card_corner_radius", "label": "Corner radius", "options": [ { "value": "0px", "label": "Square" }, { "value": "4px", "label": "Subtle" }, { "value": "12px", "label": "Rounded" } ], "default": "4px" }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      { "type": "text", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "text", "id": "social_facebook", "label": "Facebook URL" },
      { "type": "text", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "text", "id": "social_youtube", "label": "YouTube URL" }
    ]
  }
]
